{
  "name": "nutri-lu-backend",
  "version": "0.1.0",
  "description": "Backend para o App Nutri Lu 2.0 — extração de receitas via IA e análise de pratos por foto.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "backup": "node scripts/backup.mjs",
    "backup:remoto": "node scripts/backup-remoto.mjs",
    "worker": "node src/worker.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.3",
    "nodemailer": "^10.0.10",
    "openai": "^4.77.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0"
  }
